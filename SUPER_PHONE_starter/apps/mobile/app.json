{
  "expo": {
    "name": "SUPER PHONE",
    "slug": "super-phone",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.superphone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08152F"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول لصورك لإرفاقها بإعلانك."
        }
      ]
    ]
  }
}