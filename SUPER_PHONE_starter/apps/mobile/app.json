{
  "expo": {
    "name": "SUPER PHONE",
    "slug": "super-phone",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.superphone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول لصورك لإرفاقها بإعلانك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم SUPER PHONE موقعك لتحديد المحافظة والمنطقة القريبتين منك."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "light-content"
    }
  }
}
